# ==========================================
# OL CREATIVE STUDIO — ENVIRONMENT
# ==========================================

# Database
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
PROSPECTION_SENDING_ENABLED=false
PROSPECTION_TEST_EMAIL=

# ------------------------------------------------------------
# Mail SMTP
# ------------------------------------------------------------

MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=contact@olcreativestudio.fr
MAIL_FROM_NAME="OL Creative Studio"

# ------------------------------------------------------------
# Inbox / IMAP
# ------------------------------------------------------------

INBOX_MONITORING_ENABLED=false
IMAP_HOST=ssl0.ovh.net
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

PROSPECTION_INBOX_BATCH_LIMIT=50
PROSPECTION_INBOX_DRY_RUN=true
